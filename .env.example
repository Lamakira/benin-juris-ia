# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Model Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5-mini

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION_NAME=benin_code_numerique

# Ingestion Configuration
PDF_SOURCE_PATH=data/raw/CODE-DU-NUMERIQUE.pdf
PROCESSED_OUTPUT_PATH=data/processed/articles.json

# Application Configuration
APP_TITLE=BÉNIN JURIS-IA
APP_DESCRIPTION=Assistant juridique basé sur le Code du Numérique du Bénin

# Logging Configuration
LOG_LEVEL=INFO


# CONFIGURATION DU MODE (openai ou local)
RAG_PROVIDER=openai

# CONFIGURATION LOCALE (Optionnel tant que tu es en mode openai)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=mistral
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large

